# Gist Plus Production Environment Configuration
# Copy this file to .env.devnet, .env.testnet, or .env.mainnet

# ============================================
# NETWORK CONFIGURATION
# ============================================

# Solana network: localnet | devnet | testnet | mainnet-beta
SOLANA_NETWORK=devnet

# Solana RPC URL (leave empty for default public RPC)
# For production mainnet, USE A PREMIUM RPC!
# SOLANA_RPC=https://rpc.helius.xyz/?api-key=YOUR_API_KEY
# SOLANA_RPC=https://your-endpoint.quiknode.pro/YOUR_KEY/
SOLANA_RPC=

# ============================================
# WALLET CONFIGURATION
# ============================================

# Provider/Agent wallet private key (base64 encoded)
# Generate: node -e "console.log(Buffer.from(require('@solana/web3.js').Keypair.generate().secretKey).toString('base64'))"
# WARNING: KEEP THIS SECRET! Never commit to git!
WALLET_PRIVATE_KEY=

# ============================================
# PROVIDER CONFIGURATION
# ============================================

# Provider API endpoint (your server URL)
PROVIDER_ENDPOINT=http://localhost:3000

# Server port
PORT=3000

# ============================================
# PRICING CONFIGURATION
# ============================================

# Base price per request
BASE_PRICE=0.001

# Payment token: SOL | USDC | USDT | BONK
TOKEN=USDC

# ============================================
# SLA CONFIGURATION
# ============================================

# Maximum latency in milliseconds
MAX_LATENCY=2000

# Minimum uptime percentage
MIN_UPTIME=99.5

# Session duration in milliseconds (default: 10 minutes)
SESSION_DURATION=600000

# ============================================
# MONITORING (Optional)
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=

# Datadog API key for monitoring
# DATADOG_API_KEY=

# Log level: debug | info | warn | error
LOG_LEVEL=info

